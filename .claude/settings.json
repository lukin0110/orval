{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "Bash(poe test *)",
      "Bash(poe lint *)",
      "Bash(git stash *)",
      "Bash(git checkout *)",
      "Bash(.claude/hooks/lint-test.sh:*)",
      "Bash(uv run *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-test.sh",
            "timeout": 600,
            "statusMessage": "Running lint & tests..."
          }
        ]
      }
    ]
  }
}
